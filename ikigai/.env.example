# Optional legacy: call OpenAI from the app server on /reflect.
# Preferred flow (esp. Hong Kong): copy the generated prompt into
# ChatGPT / Claude / Gemini yourself, then paste the JSON reply back.
# Without this key, outsourced + built-in local guide still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to 0 to force skipping server-side OpenAI even if a key is present.
OPENAI_REFLECT=
