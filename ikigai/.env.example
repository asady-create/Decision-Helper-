# Optional: enable live LLM reflections on /reflect
# Without this key, Ikigai uses the built-in contemplative engine
# (works offline / in any region, including Hong Kong).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to 0 to force local engine even if a key is present
# (useful if OpenAI is blocked in your region).
OPENAI_REFLECT=
